---
import heroImageOne from "../../assets/hero-img-1.svg";
import heroImageTwo from "../../assets/hero-img-2.svg";
import { loadSingle } from "../../cms/content";

const hero = await loadSingle("hero");
---

<section
  class="section_home_about"
  style={`--about-img-1: url("${heroImageOne.src}"); --about-img-2: url("${heroImageTwo.src}");`}
  aria-labelledby="home-about-heading"
>
  <div class="home_about_mesh" aria-hidden="true"></div>

  <div class="home_about_content">
    <div class="home_about_copy">
      <h1 id="home-about-heading">{hero.heading}</h1>
      <p>{hero.paragraph}</p>
    </div>

    <div class="home_about_actions">
      {hero.primaryLabel && <a class="home_about_button is-primary" href={String(hero.primaryHref)}>{hero.primaryLabel}</a>}
      {hero.secondaryLabel && <a class="home_about_button is-secondary" href={String(hero.secondaryHref)}>{hero.secondaryLabel}</a>}
    </div>
  </div>
</section>

