---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  quote: string;
  logo: {
    src: ImageMetadata;
    alt?: string;
    width?: number;
  };
  author: {
    image: ImageMetadata;
    name: string;
    role: string;
    alt?: string;
  };
}

const { quote, logo, author } = Astro.props;
---

<article class="testimonial_card">
  <div class="testimonial_main">
    <Image
      class="testimonial_logo"
      src={logo.src}
      alt={logo.alt ?? ""}
      width={logo.width}
      loading="lazy"
    />
    <blockquote class="testimonial_quote">"{quote}"</blockquote>
  </div>
  <div class="testimonial_author">
    <Image
      class="testimonial_avatar"
      src={author.image}
      alt={author.alt ?? ""}
      width={60}
      height={60}
      loading="lazy"
    />
    <div class="testimonial_author_text">
      <p class="testimonial_name">{author.name}</p>
      <p class="testimonial_role">{author.role}</p>
    </div>
  </div>
</article>
