---
import PlatformCard from "../homeplatformcard/PlatformCard.astro";
import PlatformGrid from "../homeplatformcard/PlatformGrid.astro";
import SectionHeader from "../common/SectionHeader.astro";

const capabilities = [
  {
    title: "Profiling",
    description: "Builds a living AI model of your application: UI, workflows, APIs and how they change.",
    icon: "profiling"
  },
  {
    title: "Test design",
    description: "Turns intent into meaningful coverage, in Gherkin, with datasets. Deduplication keeps it lean.",
    icon: "test-design"
  },
  {
    title: "Auto-code",
    description: "Production-grade scripts generated in the framework and language you already use.",
    icon: "auto-code"
  },
  {
    title: "Schedule & execute",
    description: "Impact analysis runs only the tests a change touches; smart ordering sequences them.",
    icon: "execute"
  },
  {
    title: "Optimization",
    description: "Auto-healing fixes broken locators as the app moves, so the estate evolves instead of rotting.",
    icon: "optimization"
  },
  {
    title: "Reporting",
    description: "Intelligent reports and algoQA Copilot turn every run into answers, traced back to intent.",
    icon: "reporting"
  }
];
---

<section class="section_platform" id="platform" aria-labelledby="platform-heading">
  <svg class="platform_gradients" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="algoqa-platform-icon-gradient" gradientUnits="userSpaceOnUse" x1="2" y1="9" x2="34" y2="27">
        <stop offset="0.04" stop-color="#1B9DD9" />
        <stop offset="0.93" stop-color="#00B4A0" />
      </linearGradient>
    </defs>
  </svg>

  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-large">
        <div class="home_platform_component">
          <SectionHeader
            eyebrow="About algoQA"
            title="See the platform in action."
            description="An AI-augmented autonomous testing platform for intelligent automation of software testing, leveraging GenAI and agentic AI. Six stages, continuously. Each one feeds the next, and the whole loop learns the application as it runs."
            titleId="platform-heading"
            className="home_platform_header"
            eyebrowClass="home_platform_eyebrow text-style-allcaps text-color-teal"
            titleClass="heading-style-h2 is-white"
            descriptionClass="text-size-large is-light"
          />

          <PlatformGrid>
            {capabilities.map((capability) => (
              <PlatformCard title={capability.title} description={capability.description}>
                <svg slot="icon" class="home_platform_icon" viewBox="0 0 40 40" fill="none" stroke="url(#algoqa-platform-icon-gradient)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {capability.icon === "profiling" && (
                      <>
                        <rect x="4" y="4" width="14" height="14" rx="2.5" />
                        <rect x="22" y="4" width="14" height="14" rx="2.5" />
                        <rect x="4" y="22" width="14" height="14" rx="2.5" />
                        <rect x="22" y="22" width="14" height="14" rx="2.5" />
                      </>
                    )}
                    {capability.icon === "test-design" && (
                      <>
                        <path d="m5 11 3 3 5-6" />
                        <path d="M19 12h16" />
                        <path d="m5 22 3 3 5-6" />
                        <path d="M19 23h16" />
                        <path d="M5 33h8" />
                        <path d="M19 34h16" />
                      </>
                    )}
                    {capability.icon === "auto-code" && (
                      <>
                        <path d="M14 11 4 20l10 9" />
                        <path d="m26 11 10 9-10 9" />
                        <path d="m22.5 7-5 26" />
                      </>
                    )}
                    {capability.icon === "execute" && (
                      <>
                        <rect x="5" y="8" width="30" height="27" rx="3" />
                        <path d="M5 16h30" />
                        <path d="M13 4v8" />
                        <path d="M27 4v8" />
                        <path d="m17 22 8 5-8 5z" />
                      </>
                    )}
                    {capability.icon === "optimization" && (
                      <>
                        <path d="M5 12h5.5" />
                        <path d="M17.5 12H35" />
                        <circle cx="14" cy="12" r="3.5" />
                        <path d="M5 20h18.5" />
                        <path d="M30.5 20H35" />
                        <circle cx="27" cy="20" r="3.5" />
                        <path d="M5 28h9.5" />
                        <path d="M21.5 28H35" />
                        <circle cx="18" cy="28" r="3.5" />
                      </>
                    )}
                    {capability.icon === "reporting" && (
                      <>
                        <path d="M5 5v30h30" />
                        <path d="M13 29V20" />
                        <path d="M21 29V13" />
                        <path d="M29 29V9" />
                      </>
                    )}
                </svg>
              </PlatformCard>
            ))}
          </PlatformGrid>
        </div>
      </div>
    </div>
  </div>
</section>
