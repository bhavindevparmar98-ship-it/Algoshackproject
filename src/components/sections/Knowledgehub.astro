---
import { loadList, sanitizeSvgShapes } from "../../cms/content";

interface Props {
  eyebrow?: string;
  heading?: string;
  text?: string;
}

const { items, header } = await loadList("knowledge");
const eyebrow = Astro.props.eyebrow ?? String(header.eyebrow);
const heading = Astro.props.heading ?? String(header.heading);
const text = Astro.props.text ?? String(header.text);

const cards = items.map((item) => ({
  title: String(item.title),
  text: String(item.text),
  href: String(item.href || "#"),
  icon: sanitizeSvgShapes(String(item.icon ?? "")),
}));
---

<section class="section_knowledge" id="knowledge-hub" aria-labelledby="knowledge-heading">
  <svg class="knowledge_gradients" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="algoqa-knowledge-icon-gradient" gradientUnits="userSpaceOnUse" x1="2" y1="9" x2="34" y2="27">
        <stop offset="0.04" stop-color="#1B9DD9"></stop>
        <stop offset="0.93" stop-color="#00B4A0"></stop>
      </linearGradient>
    </defs>
  </svg>

  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-large">
        <div class="knowledge_component">
          <header class="knowledge_header">
            <span class="knowledge_eyebrow text-style-allcaps text-color-teal">{eyebrow}</span>
            <h2 class="heading-style-h2 is-white" id="knowledge-heading">{heading}</h2>
            <p class="text-size-large is-light">{text}</p>
          </header>

          <ul class="knowledge_grid" role="list">
            {cards.map((card) => (
              <li class="knowledge_item">
                <a href={card.href} class="knowledge_card">
                  <div class="knowledge_icon-wrap">
                    <svg
                      class="knowledge_icon"
                      viewBox="0 0 40 40"
                      width="40"
                      height="40"
                      fill="none"
                      stroke="url(#algoqa-knowledge-icon-gradient)"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      focusable="false"
                      set:html={card.icon}
                    />
                  </div>
                  <div class="knowledge_card-content">
                    <h3 class="knowledge_card-title heading-style-h5 is-white">{card.title}</h3>
                    <p class="knowledge_card-text text-size-regular is-light">{card.text}</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .section_knowledge .padding-global {
    width: 100%;
    padding-left: 5rem;
    padding-right: 5rem;
  }
  .section_knowledge .container-large {
    width: 100%;
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
  }
  .section_knowledge .padding-section-large {
    padding-top: 6rem;
    padding-bottom: 6rem;
  }

  .section_knowledge .heading-style-h2 {
    margin: 0;
    font-family: "Source Serif 4", serif;
    font-weight: 600;
    font-size: 2.75rem;
    line-height: 3.0625rem;
    letter-spacing: -0.015em;
    text-align: center;
    color: #fff;
  }
  .section_knowledge .heading-style-h5 {
    margin: 0;
    font-family: "Inter", sans-serif;
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.8125rem;
    letter-spacing: -0.005em;
    color: #fff;
  }
  .section_knowledge .text-size-large {
    margin: 0;
    font-family: "Inter", sans-serif;
    font-size: 1.125rem;
    line-height: 1.8125rem;
    text-align: center;
    color: #e4e9ed;
  }
  .section_knowledge .text-size-regular {
    margin: 0;
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.625rem;
    color: #e4e9ed;
  }
  .section_knowledge .text-style-allcaps {
    font-family: "Inter", sans-serif;
    font-weight: 600;
    font-size: 0.8125rem;
    line-height: 1.0625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .section_knowledge .text-color-teal {
    color: #00b4a0;
  }
  .section_knowledge ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .section_knowledge {
    background-color: #0e2a3d;
  }
  .knowledge_gradients {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .knowledge_component {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5rem;
  }
  .knowledge_header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 50rem;
  }
  .knowledge_eyebrow {
    margin: 0;
  }
  .knowledge_grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
  }
  .knowledge_item {
    display: flex;
  }
  .knowledge_card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    width: 100%;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .knowledge_card:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(0, 180, 160, 0.6);
    transform: translateY(-0.25rem);
  }
  .knowledge_card:focus-visible {
    outline: 0.125rem solid #00b4a0;
    outline-offset: 0.25rem;
  }
  .knowledge_icon-wrap {
    box-sizing: border-box;
    flex: none;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0.375rem;
    border-radius: 0.25rem;
  }
  .knowledge_icon {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    overflow: visible;
  }
  .knowledge_card-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 991px) {
    .section_knowledge .padding-global {
      padding-left: 2.5rem;
      padding-right: 2.5rem;
    }
    .section_knowledge .padding-section-large {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
    .section_knowledge .heading-style-h2 {
      font-size: 2.25rem;
      line-height: 2.5625rem;
      letter-spacing: -0.01em;
    }
    .knowledge_component {
      gap: 3.5rem;
    }
    .knowledge_grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .section_knowledge .padding-global {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
    .section_knowledge .padding-section-large {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
    .section_knowledge .heading-style-h2 {
      font-size: 2rem;
      line-height: 2.25rem;
    }
    .section_knowledge .text-size-large {
      font-size: 1rem;
      line-height: 1.625rem;
    }
    .knowledge_component {
      gap: 2.5rem;
    }
    .knowledge_grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .knowledge_card {
      transition: none;
    }
    .knowledge_card:hover {
      transform: none;
    }
  }
</style>
