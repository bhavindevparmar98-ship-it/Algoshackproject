---
import { Image } from "astro:assets";
import avatarOne from "../../assets/team-1.svg";
import avatarTwo from "../../assets/team-2.svg";
import avatarThree from "../../assets/team-3.svg";

const team = [
  { name: "Aarav Shah", role: "Founder & Strategy Lead", image: avatarOne },
  { name: "Nisha Rao", role: "Product Design Director", image: avatarTwo },
  { name: "Daniel Brooks", role: "Delivery Principal", image: avatarThree }
];
---

<section class="section_team" id="team">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-medium">
        <div class="team_component">
          <div class="section_heading">
            <span class="eyebrow">Meet the team</span>
            <h2 class="heading-style-h2">A small team with a clear point of view.</h2>
          </div>

          <div class="team_grid">
            {team.map((member) => (
              <article class="team_member card">
                <div class="team_member_image">
                  <Image src={member.image} alt={`${member.name} profile illustration`} />
                </div>
                <div class="team_member_content">
                  <h3 class="heading-style-h5">{member.name}</h3>
                  <p class="text-size-small text-color-secondary">{member.role}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
