---
import LeaderCard from "./LeaderCard.astro";
import SectionHeader from "../common/SectionHeader.astro";
import { loadList } from "../../cms/content";

const { items: leaders, header } = await loadList("leadership");
const paragraphs = (bio: unknown) =>
  String(bio ?? "").split(/\n\s*\n/).map((part) => part.trim()).filter(Boolean);
---

<section class="leadership" id="leadership">
  <SectionHeader
    eyebrow={String(header.eyebrow)}
    title={String(header.title)}
    description={String(header.description ?? "")}
    className="leadership__header"
    eyebrowClass="leadership__eyebrow"
    titleWrapClass="leadership__titles"
    titleClass="leadership__title"
    descriptionClass="leadership__description text-size-large"
  />

  <div class="leadership__grid">
    {
      leaders.map((leader) => {
        const bio = paragraphs(leader.bio);
        const props = {
          name: String(leader.name),
          role: String(leader.role),
          image: String(leader.image),
          linkedin: leader.linkedin ? String(leader.linkedin) : undefined,
        };
        return bio.length ? (
          <LeaderCard {...props}>
            {bio.map((text) => <p>{text}</p>)}
          </LeaderCard>
        ) : (
          <LeaderCard {...props} />
        );
      })
    }
  </div>
</section>
