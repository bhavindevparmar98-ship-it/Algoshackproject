---
import g2Logo from "../../assets/review-img1.svg";
import capterraLogo from "../../assets/review-img2.svg";
import sourceForgeLogo from "../../assets/review-img3.svg";
import peerSpotLogo from "../../assets/review-img4.svg";
import softwareSuggestLogo from "../../assets/review-img5.svg";
import techJockeyLogo from "../../assets/review-img7.svg";
import trustBadgeIcon from "../../assets/trust-badge.svg";

interface Props {
  eyebrow?: string;
  heading?: string;
  text?: string;
}

const {
  eyebrow = "Trust & credibility",
  heading = "Why teams take the call.",
  text = "Ranked #3 among 900+ testing companies worldwide, with 2,000+ person-years of testing expertise behind the platform.",
} = Astro.props;

const stats = [
  { value: "90%+", label: "Test coverage" },
  { value: "15X", label: "Productivity boost" },
  { value: "80%", label: "Lower cost" },
  { value: "3X+", label: "ROI" },
  { value: "96", label: "SaaS NPS" },
  { value: "94", label: "Enterprise NPS" },
  { value: "#3", label: "Ranked globally" },
  { value: "900+", label: "Testing companies" },
];

const badges = ["ISO 27001", "SOC 2 Type II", "ISO 9001", "IEC 62304", "ISO 14971", "SSO + SAML"];
const reviews = [
  { name: "G2", rating: "4.9", logo: g2Logo },
  { name: "Capterra", rating: "4.4", logo: capterraLogo },
  { name: "Source Forge", rating: "4.5", logo: sourceForgeLogo },
  { name: "PeerSpot", rating: "5.0", logo: peerSpotLogo },
  { name: "SoftwareSuggest", rating: "5.0", logo: softwareSuggestLogo },
  { name: "Tech Jockey", rating: "4.7", logo: techJockeyLogo },
];
---

<section class="section_trust" id="trust" aria-labelledby="trust-heading">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-large">
        <div class="trust_component">
          <header class="trust_header">
            <span class="trust_eyebrow">{eyebrow}</span>
            <div class="trust_header-text">
              <h2 class="heading-style-h2" id="trust-heading">{heading}</h2>
              <p class="text-size-large">{text}</p>
            </div>
          </header>

          <div class="trust_content">
            <div class="trust_body">
              <ul class="trust_stats" role="list">
                {stats.map((stat) => (
                  <li class="trust_stat">
                    <p class="trust_stat-number home_stats_number heading-style-display">{stat.value}</p>
                    <p class="trust_stat-label">{stat.label}</p>
                  </li>
                ))}
              </ul>

              <ul class="trust_badges" role="list">
                {badges.map((badge) => (
                  <li class="trust_badge">
                    <img
                      class="trust_badge-icon"
                      src={trustBadgeIcon.src}
                      alt=""
                      width="40"
                      height="40"
                      aria-hidden="true"
                    />
                    <span class="trust_badge-text">{badge}</span>
                  </li>
                ))}
              </ul>
            </div>

            <ul class="trust_reviews" role="list" aria-label="Review platform ratings">
              {reviews.map((review) => (
                <li class="trust_review">
                  <div class="trust_review-item">
                    <span class="trust_review-logo">
                      <img src={review.logo.src} alt="" width="auto" height="32" loading="lazy" />
                    </span>
                 
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section_trust {
    background: #0e2a3d;
    color: white;
  }

  .trust_component {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem;
  }

  .trust_header {
    display: flex;
    width: 100%;
    max-width: 50rem;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .trust_eyebrow {
    color: #00b4a0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.0625rem;
    text-transform: uppercase;
  }

  .trust_header-text {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 1rem;
  }

  .trust_header .heading-style-h2 {
    max-width: none;
    color: white;
    font-size: 2.75rem;
    line-height: 3.0625rem;
    text-align: center;
  }

  .trust_header .text-size-large {
    max-width: none;
    color: #b4c0c8;
    text-align: center;
  }

  .trust_content,
  .trust_body {
    display: flex;
    width: 100%;
    flex-direction: column;
  }

  .trust_content {
    gap: 3rem;
  }

  .trust_body {
    gap: 1.5rem;
  }

  .trust_stats {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 0;
  }

  .trust_stat {
    display: flex;
    min-height: 9.875rem;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    margin-left: -1px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 1.75rem;
    background: rgba(255, 255, 255, 0.08);
    text-align: center;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .trust_stat:nth-child(4n + 1) {
    margin-left: 0;
    border-radius: 0.5rem 0 0 0.5rem;
  }

  .trust_stat:nth-child(4n) {
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .trust_stat-number {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 4rem;
    font-weight: 600;
    line-height: 1.05;
  }

  .trust_stat-label {
    margin: 0;
    color: #b4c0c8;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.25rem;
    text-transform: uppercase;
  }

  .trust_badges {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .trust_badge {
    display: flex;
    min-height: 4.625rem;
    flex: 1 1 12.5rem;
    align-items: center;
    gap: 0.625rem;
    border: 1px solid rgba(228, 233, 237, 0.2);
    border-radius: 0.25rem;
    padding: 1rem 0.9375rem;
    background: rgba(255, 255, 255, 0.05);
  }

  .trust_badge-icon {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    opacity: 0.5;
  }

  .trust_badge-text {
    color: white;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.5rem;
    white-space: nowrap;
  }

  .trust_reviews {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem 2.5rem;
  }

  .trust_review-item {
    display: flex;
    min-height: 2rem;
    align-items: center;
    gap: 0.75rem;
  }

  .trust_review-logo {
    display: flex;
    width: auto;
    height: 2rem;
    flex: none;
    align-items: center;
    justify-content: center;
  }

  .trust_review-logo img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .trust_review-name,
  .trust_review-score {
    color: white;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.1875rem;
  }

  /* .trust_review-rating {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .trust_review-star {
    display: block;
    width: 1rem;
    height: 1rem;
    flex: none;
  } */

  @media (max-width: 992px) {
    .trust_component {
      gap: 3rem;
    }

    .trust_content {
      gap: 2.5rem;
    }

    .trust_stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      row-gap: 1.5rem;
    }

    .trust_stat,
    .trust_stat:nth-child(4n + 1),
    .trust_stat:nth-child(4n) {
      border-radius: 0;
    }

    .trust_stat {
      margin-left: -1px;
    }

    .trust_stat:nth-child(4n + 1) {
      margin-left: 0;
      border-radius: 0.25rem 0 0 0.25rem;
    }

    .trust_stat:nth-child(4n) {
      border-radius: 0 0.25rem 0.25rem 0;
    }

    .trust_stat {
      min-height: 10.3125rem;
      gap: 0.5rem;
      padding: 0.75rem 0.5rem;
    }

    .trust_stat-number {
      font-size: 3rem;
      line-height: 3rem;
    }

    .trust_stat-label {
      font-size: 0.75rem;
      line-height: 1rem;
    }
  }

  @media (max-width: 767px) {
    .trust_component {
      gap: 2.5rem;
    }

    .trust_header .heading-style-h2 {
      font-size: 2rem;
      line-height: 2.25rem;
    }

    .trust_header .text-size-large {
      font-size: 1rem;
      line-height: 1.625rem;
    }
     .trust_stat-number {
      font-size: 2.75rem;
      line-height: 3.063rem;
    }

    .trust_stat {
      min-height: 9.25rem;
      gap: 0.5rem;
      padding: 0.75rem 0.5rem;
    }

    .trust_badge {
      flex-basis: calc(50% - 0.5rem);
    }

    .trust_badge-text {
      font-size: 1rem;
      line-height: 1.375rem;
      white-space: normal;
    }

    .trust_reviews {
      gap: 1.25rem 1.5rem;
    }
  }

  @media (max-width: 478px) {
    .trust_stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 0;
    }

    .trust_stat {
      margin-left: -1px;
    }

    .trust_stat:nth-child(odd) {
      margin-left: 0;
    }

    .trust_stat:nth-child(n + 3) {
      margin-top: -1px;
    }

    .trust_stat:nth-child(4n + 1) {
      border-radius: 0.5rem 0 0 0;
    }

    .trust_stat:nth-child(4n + 2) {
      border-radius: 0 0.5rem 0 0;
    }

    .trust_stat:nth-child(4n + 3) {
      border-radius: 0 0 0 0.5rem;
    }

    .trust_stat:nth-child(4n) {
      border-radius: 0 0 0.5rem 0;
    }

    .trust_stat:nth-child(5),
    .trust_stat:nth-child(6) {
      margin-top: 1.5rem;
    }

    .trust_stat:nth-child(5) {
      margin-left: 0;
    }

    .trust_badge {
      flex-basis: 100%;
    }

    .trust_reviews {
      justify-content: flex-start;
    }
  }
</style>
