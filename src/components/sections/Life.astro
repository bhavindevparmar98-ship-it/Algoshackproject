---
import SectionHeader from "../common/SectionHeader.astro";
import LifeCard from "./life/LifeCard.astro";
import MarqueeSlider from "./marquee-slider/MarqueeSlider.astro";
import { loadList } from "../../cms/content";

const { items, header } = await loadList("life");
const stories = items.map((item) => ({
  image: String(item.image),
  alt: String(item.alt ?? ""),
  quote: String(item.quote),
  name: String(item.name),
  role: String(item.role ?? ""),
}));
---

<section class="section_life" aria-labelledby="life-heading">
  <div class="padding-section-large">
    <div class="life_component">
      <div class="padding-global">
        <div class="container-large">
          <SectionHeader
            eyebrow={String(header.eyebrow)}
            title={String(header.title)}
            description={String(header.description ?? "")}
            titleId="life-heading"
            className="life_header"
            eyebrowClass="life_eyebrow text-style-allcaps text-color-blue"
            titleClass="heading-style-h2"
            descriptionClass="text-size-large"
          />
        </div>
      </div>

      <MarqueeSlider speed={40} label="Life at AlgoShack">
        {stories.map((story) => <LifeCard {...story} />)}
      </MarqueeSlider>
    </div>
  </div>
</section>
