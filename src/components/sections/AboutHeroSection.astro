---
import { Image } from "astro:assets";
import heroIllustration from "../../assets/about-hero.svg";
---

<section class="section_about_hero">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-large">
        <div class="about_hero_component">
          <div class="about_hero_content">
            <span class="eyebrow">Our story</span>
            <h1 class="heading-style-h1 heading-style-display">Quality engineering, built for the age of AI.</h1>
            <p class="about_hero_text text-size-large text-color-secondary">
              AlgoShack helps software teams deliver better products faster through autonomous testing and quality engineering. Our platform, algoQA, brings AI into every stage of the software development lifecycle.
            </p>
            <div class="about_hero_actions">
              <a class="button is-primary" href="#timeline">Our journey</a>
              <a class="button is-secondary" href="#leadership">Meet our leaders</a>
            </div>
            <ul class="about_hero_trust" aria-label="Key company metrics">
              <li>
                <strong>8+</strong>
                <span>Years of quality engineering</span>
              </li>
              <li>
                <strong>250+</strong>
                <span>Enterprise engagements</span>
              </li>
            </ul>
          </div>

          <div class="about_hero_visual">
            <div class="about_hero_image_wrap">
              <Image src={heroIllustration} alt="Illustration of product strategy and teamwork" class="about_hero_image" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
