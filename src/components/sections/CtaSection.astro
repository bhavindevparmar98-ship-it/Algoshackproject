---
import { Image } from "astro:assets";
import ctaSection from "../../assets/cta-bg-img.png";
---

<section class="cta-section">
    <div class="padding-global">
        <div class="container-small">
            <div class="padding-section-small">
                <div class="cta-component">
                    <div class="cta-content">
                        <div class="cta-content_header">
                            <h2 class="heading-style-h2 is-white">
                                Let's build something worth trusting.
                            </h2>
                            <p class="text-size-large is-light">
                                Book a demo and see the agents run against a
                                slice of your own application, or talk to us
                                about joining the team. Zero setup cost to
                                begin.
                            </p>
                        </div>
                        <div class="cta-buttons_wrapper">
                            <a href="#" class="cta-btn">Get Started</a>
                            <a href="#" class="cta-btn">Get Started</a>                         
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
