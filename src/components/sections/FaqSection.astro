---
import SectionHeader from "../common/SectionHeader.astro";
import { loadList } from "../../cms/content";

const { items, header } = await loadList("faqs");
const faqs = items.map((item) => ({ question: String(item.question), answer: String(item.answer) }));
---

<section class="section_faq" id="faq" aria-labelledby="faq-heading">
  <div class="padding-global">
    <div class="faq_component">
      <SectionHeader
        eyebrow={String(header.eyebrow)}
        title={String(header.title)}
        description={String(header.description ?? "")}
        titleId="faq-heading"
        className="faq_header"
        eyebrowClass="faq_eyebrow"
        titleWrapClass="faq_header-text"
        titleClass="faq_heading"
        descriptionClass="faq_subtext text-size-large"
      />

      <div class="faq_list" data-faq>
        {faqs.map((item, index) => {
          const open = index === 0;
          const questionId = `faq-question-${index}`;
          const answerId = `faq-answer-${index}`;

          return (
            <div class:list={["faq_item", { "is-open": open }]} data-faq-item>
              <span class="faq_icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="16" height="16" fill="none">
                  <path
                    d="M5.75 2.5 11.25 8l-5.5 5.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <h3 class="faq_question-wrap heading-style-h3">
                <button
                  type="button"
                  class="faq_question"
                  id={questionId}
                  aria-expanded={open ? "true" : "false"}
                  aria-controls={answerId}
                  data-faq-trigger
                >
                  {item.question}
                </button>
              </h3>

              <div
                class="faq_answer-wrap"
                id={answerId}
                role="region"
                aria-labelledby={questionId}
                aria-hidden={!open ? "true" : "false"}
                inert={!open}
              >
                <div class="faq_answer-inner">
                  <p class="faq_answer">{item.answer}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  import "../../scripts/faq-animations";
</script>
