---
interface Props {
  name: string;
  role: string;
  image: string;
  linkedin?: string;
}

const { name, role, image, linkedin } = Astro.props;
const hasBio = Astro.slots.has("default");

const slug = (value: string) =>
  value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
const bioId = `bio-${slug(name)}-${slug(role)}`;
---

<article class:list={["leader-card", { "has-bio": hasBio }]}>
  <img
    class="leader-card__photo"
    src={image}
    alt={name}
    width="308"
    height="260"
    loading="lazy"
  />

  <div class="leader-card__sheet">
    <div class="leader-card__head">
      <div class="leader-card__who">
        <h3 class="heading-style-h3">{name}</h3>
        <p class="leader-card__role">{role}</p>
      </div>

      {
        linkedin && (
          <a
            class="leader-card__linkedin"
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${name} on LinkedIn`}
          >
            <svg viewBox="0 0 256 256" width="24" height="24" fill="currentColor" aria-hidden="true">
              <path d="M216 24H40a16 16 0 0 0-16 16v176a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V40a16 16 0 0 0-16-16Zm0 192H40V40h176v176ZM96 112v64a8 8 0 0 1-16 0v-64a8 8 0 0 1 16 0Zm88 28v36a8 8 0 0 1-16 0v-36a20 20 0 0 0-40 0v36a8 8 0 0 1-16 0v-64a8 8 0 0 1 15.79-1.78A36 36 0 0 1 184 140Zm-84-56a12 12 0 1 1-12-12 12 12 0 0 1 12 12Z" />
            </svg>
          </a>
        )
      }
    </div>

    <div class="leader-card__rest">
      {
        hasBio && (
          <div class="leader-card__bio" id={bioId}>
            <hr />
            <div class="leader-card__bio-text">
              <slot />
            </div>
          </div>
        )
      }
    </div>
  </div>

  {
    hasBio && (
      <button
        type="button"
        class="leader-card__toggle"
        aria-expanded="false"
        aria-controls={bioId}
      >
        <svg class="leader-card__icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" />
        </svg>
        <span class="leader-card__toggle-label">see bio</span>
      </button>
    )
  }
</article>

<script>
  const ONE_AT_A_TIME = true;
  const CLOSE_MS = 450;
  const cards = document.querySelectorAll<HTMLElement>(".leader-card.has-bio");

  function setOpen(card: HTMLElement, open: boolean) {
    if (card.classList.contains("is-open") === open) return;

    card.classList.toggle("is-open", open);

    const button = card.querySelector<HTMLButtonElement>(".leader-card__toggle");
    const label = card.querySelector<HTMLElement>(".leader-card__toggle-label");
    button?.setAttribute("aria-expanded", String(open));
    if (label) label.textContent = open ? "hide bio" : "see bio";

    if (!open) {
      window.setTimeout(() => {
        if (card.classList.contains("is-open")) return;
        const bio = card.querySelector<HTMLElement>(".leader-card__bio");
        if (bio) bio.scrollTop = 0;
      }, CLOSE_MS);
    }
  }

  cards.forEach((card) => {
    card.querySelector(".leader-card__toggle")?.addEventListener("click", () => {
      const willOpen = !card.classList.contains("is-open");
      if (ONE_AT_A_TIME && willOpen) {
        cards.forEach((otherCard) => {
          if (otherCard !== card) setOpen(otherCard, false);
        });
      }
      setOpen(card, willOpen);
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") cards.forEach((card) => setOpen(card, false));
  });
</script>
