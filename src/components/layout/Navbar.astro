---
const links = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];
---

<header class="site_header">
  <div class="padding-global">
    <div class="container-large">
      <nav class="navbar_component" aria-label="Main">
        <a href="/" class="navbar_brand" aria-label="AlgoShack home">
          <span class="brand_mark">A</span>
          <span class="brand_text">AlgoShack</span>
        </a>

        <div class="navbar_links">
          {links.map(({ label, href }) => (
            <a href={href} aria-current={Astro.url.pathname === href ? "page" : undefined}>
              {label}
            </a>
          ))}
        </div>

        <a class="button is-primary" href="/contact">Get in touch</a>
      </nav>
    </div>
  </div>
</header>
