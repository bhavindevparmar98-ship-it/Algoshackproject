---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/layout/Footer.astro";
import HomepageNavbar from "../components/layout/HomepageNavbar.astro";
import HomeAboutSection from "../components/sections/HomeAboutSection.astro";
import HomeStatsSection from "../components/sections/HomeStatsSection.astro";
import HomeJourneySection from "../components/sections/HomeJourneySection.astro";
import HomeTimelineSection from "../components/sections/HomeTimelineSection.astro";
import HomeValuesSection from "../components/sections/HomeValuesSection.astro";
import HomePlatformSection from "../components/sections/HomePlatformSection.astro";
import UseCasesSection from "../components/sections/UseCasesSection.astro";
import LeadershipSection from "../components/sections/LeadershipSection.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import Life from "../components/sections/Life.astro";
import LocationsSection from "../components/sections/LocationsSection.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import Knowledgehub from "../components/sections/Knowledgehub.astro";
import CtaSection from "../components/sections/CtaSection.astro";
---

<BaseLayout
  title="AlgoShack – Engineering quality at the speed of AI"
  description="AlgoShack's AI-augmented autonomous testing and quality engineering platform helps teams deliver software faster."
>
  <HomepageNavbar />
  <main class="page-wrapper page-home">
    <div class="main-wrapper">
      <HomeAboutSection />
      <HomeStatsSection />
      <HomeJourneySection />
       <LeadershipSection />
      <HomeValuesSection />
      <HomePlatformSection />
      <UseCasesSection />
      <HomeTimelineSection />
      <Testimonials />
      <Life />
      <LocationsSection />
      <Knowledgehub />

      <FaqSection />
      <CtaSection
        primaryLabel="Explore algoQA"
        primaryHref="#platform"
        secondaryLabel="Contact us"
        secondaryHref="/contact"
      />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { applyKnowledgeIcons } from "../scripts/knowledge-icons";

  import "../scripts/smooth-scroll";
  import "../scripts/hero-animations";
  import "../scripts/stats-animations";
  import "../scripts/landing-animations";
  import "../scripts/section-animations";
  import "../scripts/journey-animations";
  import "../scripts/scroll-split";
  import "../scripts/leadership-animations";

  applyKnowledgeIcons(".page-home");
</script>

<style>
  :global(.page-home .home_values_header) {
    position: sticky;
    top: 7.5rem;
    align-self: flex-start;
  }

  @media (max-width: 64rem) {
    :global(.page-home .home_values_header) {
      position: static;
    }
  }
</style>
