---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import AboutHeroSection from "../components/sections/AboutHeroSection.astro";
import StorySection from "../components/sections/StorySection.astro";
import StatsSection from "../components/sections/StatsSection.astro";
import ValuesSection from "../components/sections/ValuesSection.astro";
import TeamSection from "../components/sections/TeamSection.astro";
---

<BaseLayout title="About Us | Algoshack">
  <Navbar />
  <main class="page-wrapper">
    <div class="main-wrapper">
      <AboutHeroSection />
      <StorySection />
      <StatsSection />
      <ValuesSection />
      <TeamSection />
    </div>
  </main>
  <Footer />
</BaseLayout>
