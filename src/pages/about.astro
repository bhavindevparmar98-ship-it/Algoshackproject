---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/layout/Footer.astro";
import HomepageNavbar from "../components/layout/HomepageNavbar.astro";
import AboutHeroSection from "../components/sections/AboutHeroSection.astro";
import HomeJourneySection from "../components/sections/HomeJourneySection.astro";
import HomeTimelineSection from "../components/sections/HomeTimelineSection.astro";
import HomeValuesSection from "../components/sections/HomeValuesSection.astro";
import LeadershipSection from "../components/sections/LeadershipSection.astro";
import CtaSection from "../components/sections/CtaSection.astro";
---

<BaseLayout
  title="About AlgoShack | Quality engineering for the age of AI"
  description="Learn about AlgoShack's mission, journey, leadership, and values in autonomous testing and quality engineering."
>
  <HomepageNavbar />
  <main class="page-wrapper page-about">
    <div class="main-wrapper">
      <AboutHeroSection />
      <HomeJourneySection />
      <HomeTimelineSection />
      <LeadershipSection />
      <HomeValuesSection />
      <CtaSection
        heading="Ready to make software quality autonomous?"
        text="See how AlgoShack helps teams improve testing across the software development lifecycle."
        primaryLabel="Explore algoQA"
        primaryHref="/"
        secondaryLabel="Contact us"
        secondaryHref="/contact"
      />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import "../scripts/smooth-scroll";
  import "../scripts/landing-animations";
  import "../scripts/journey-animations";
  import "../scripts/scroll-split";
</script>

<style>
  :global(.page-about .home_values_header) {
    position: sticky;
    top: 7.5rem;
    align-self: flex-start;
  }

  @media (max-width: 64rem) {
    :global(.page-about .home_values_header) {
      position: static;
    }
  }
</style>
